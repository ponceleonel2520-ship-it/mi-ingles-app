<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    tools:context=".Activity_Registro">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="32dp">

            <!-- Etiqueta superior -->

            <!-- Título -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Registro de Estudiante"
                android:textColor="#0F294A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Crea tu cuenta para sincronizar tus flashcards"
                android:textAlignment="center"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- Tarjeta del formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Nombre Completo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Nombre completo"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_limpio"
                        android:hint="Ej. Juan Pérez López"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0F294A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <!-- Matrícula -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Matrícula"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_matricula"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_limpio"
                        android:hint="Ingresa tu matrícula"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0F294A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <!-- Correo Electrónico -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Correo electrónico"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_limpio"
                        android:hint="correo@ejemplo.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0F294A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <!-- Spinner de Carrera -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Carrera"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_limpio"
                        android:paddingHorizontal="6dp">

                        <Spinner
                            android:id="@+id/spinner_carrera"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:spinnerMode="dropdown" />
                    </FrameLayout>

                    <!-- Contraseña -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Contraseña"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bg_input_limpio"
                        android:hint="Mínimo 6 caracteres"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0F294A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <!-- Botón Registrarse -->
                    <Button
                        android:id="@+id/btn_register"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:backgroundTint="#1D63ED"
                        android:text="Registrarse"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Enlace a Iniciar Sesión -->
            <TextView
                android:id="@+id/tv_login_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:text="¿Ya tienes una cuenta? Iniciar Sesión"
                android:textColor="#1A56DB"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>